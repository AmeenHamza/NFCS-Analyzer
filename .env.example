# Copy this file to .env and put your own key here. Never commit or zip .env.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Optional: tokens-per-minute limit of your Groq plan (free tier = 8000).
# Raise it on a paid plan so the app sends more context per request.
# GROQ_TOKEN_LIMIT=8000
